+TEST_CASE("resetCooldownOnFreeze is for stuns and freezes: a slow only slows", "[combat_entity][freeze][patch0050]") {
+    Board board;
+    auto target = std::make_shared<DummyEntity>(1, 0.0f, 1.0f, 10000, 1);
