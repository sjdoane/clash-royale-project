         { "Heal Spirit", 1, Source::CRAPI, 3 }, // HealSpirit 100 ms, hit speed 300 ms
         { "Hero Giant", 10, Source::FLZ }, // Giant 1000 ms
-        { "Hero Goblins", 5, Source::FLZ }, // Goblins 500 ms
