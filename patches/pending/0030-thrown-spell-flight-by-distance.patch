+            assert (E.spell_flight_ticks(ID[name], x, y, 0)
+                    == E.spell_flight_ticks(ID[name], 17.0 - x, 33.0 - y, 1)), (name, x, y)
+
+
+def test_a_spell_that_is_not_thrown_keeps_one_delay_everywhere():
+    for name in FIXED:
