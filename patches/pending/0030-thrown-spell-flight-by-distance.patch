+                 for x, y in ((3.0, 27.0), (8.5, 3.0), (14.0, 16.0))}
+        assert len(ticks) == 1, name
+    assert E.spell_flight_ticks(ID["The Log"], 3.0, 27.0) == 8
+    with pytest.raises(ValueError):
