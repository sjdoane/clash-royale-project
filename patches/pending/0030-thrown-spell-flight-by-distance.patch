+    REQUIRE(CardFactories::thrownSpellFlightTicks(stats, 3.0f, 6.0f, 0) == 10);
+    REQUIRE(CardFactories::thrownSpellFlightTicks(stats, 14.0f, 27.0f, 0) == 10);
